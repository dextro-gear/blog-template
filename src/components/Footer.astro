---
import { siteConfig } from '../config';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="copyright">
      <span>&copy; {currentYear} {siteConfig.author}</span>
    </div>

    <div class="social-links">
      {siteConfig.socialLinks.map((link) => (
        <a href={link.href} class="social-link" target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
          {link.label}
        </a>
      ))}
    </div>

    <div class="back-to-top">
      <a href="#top" id="back-to-top-btn">
        Back to top <span class="arrow">&uarr;</span>
      </a>
    </div>
  </div>
</footer>

<script>
  const btn = document.getElementById('back-to-top-btn');
  if (btn) {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<style>
  .site-footer {
    margin-top: 6rem;
    padding-top: 2.5rem;
    padding-bottom: 3.5rem;
    border-top: 1px solid var(--border-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .copyright {
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .social-link {
    color: var(--text-secondary);
    transition: color 0.15s ease;
  }

  .social-link:hover {
    color: var(--accent-terracotta);
  }

  .back-to-top a {
    color: var(--accent-terracotta);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .back-to-top a:hover {
    color: var(--accent-terracotta-hover);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .social-links {
      gap: 1.5rem;
    }
  }
</style>
