---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/date';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<article class="archive-card paper-card">
  <a href={`/posts/${post.slug}`} class="card-link-wrapper">
    <div class="card-date-col">
      <time datetime={post.data.pubDate.toISOString()} class="card-date">
        {formatDate(post.data.pubDate)}
      </time>
    </div>

    <div class="card-body-col">
      <h3 class="card-title">{post.data.title}</h3>
      <p class="card-desc">{post.data.description}</p>
      <div class="card-meta">
        <span class="badge-tag">{post.data.tag}</span>
        <span class="meta-sep">&bull;</span>
        <span class="read-time">{post.data.readTime}</span>
      </div>
    </div>

    <div class="card-arrow-col">
      <span class="arrow">&rarr;</span>
    </div>
  </a>
</article>

<style>
  .archive-card {
    border-radius: var(--radius-md);
    transition: transform 0.16s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.16s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.16s ease;
  }

  .archive-card:hover {
    border-color: #c5bba2;
  }

  .archive-card:hover .arrow {
    transform: translateX(4px);
    color: var(--accent-terracotta-hover);
  }

  .archive-card:hover .card-title {
    color: var(--accent-terracotta);
  }

  .card-link-wrapper {
    display: grid;
    grid-template-columns: 140px 1fr 40px;
    align-items: center;
    padding: 2.2rem 2.5rem;
    gap: 1.5rem;
    text-decoration: none;
    color: inherit;
  }

  .card-date-col {
    align-self: start;
    padding-top: 0.25rem;
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-subtle);
    letter-spacing: 0.02em;
  }

  .card-body-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    transition: color 0.15s ease;
  }

  .card-desc {
    font-family: var(--font-serif);
    font-size: 0.975rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.775rem;
    color: var(--text-subtle);
  }

  .meta-sep {
    color: var(--text-subtle);
  }

  .read-time {
    color: var(--text-subtle);
  }

  .card-arrow-col {
    display: flex;
    justify-content: flex-end;
    color: var(--accent-terracotta);
    font-size: 1.25rem;
  }

  .arrow {
    display: inline-block;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  @media (max-width: 768px) {
    .card-link-wrapper {
      grid-template-columns: 1fr;
      padding: 1.5rem;
      gap: 0.75rem;
    }
    .card-arrow-col {
      display: none;
    }
  }
</style>
