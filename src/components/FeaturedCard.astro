---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/date';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<article class="featured-card paper-card">
  <div class="card-meta">
    <span class="meta-date-time">{formatDate(post.data.pubDate)} &bull; {post.data.readTime} &bull;</span>
    <span class="badge-tag">{post.data.tag}</span>
  </div>

  <h3 class="card-title">
    <a href={`/posts/${post.slug}`}>{post.data.title}</a>
  </h3>

  <p class="card-desc">{post.data.description}</p>

  <div class="card-action">
    <a href={`/posts/${post.slug}`} class="read-link">
      Read full essay <span class="arrow">&rarr;</span>
    </a>
  </div>
</article>

<style>
  .featured-card {
    padding: 2.25rem 2.5rem;
    position: relative;
    border-radius: var(--radius-lg);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-subtle);
  }

  .meta-date-time {
    letter-spacing: 0.02em;
    color: var(--text-subtle);
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1.28;
    color: var(--text-primary);
    margin-bottom: 1.1rem;
    letter-spacing: -0.01em;
  }

  .card-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--accent-terracotta);
  }

  .card-desc {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
    max-width: 680px;
  }

  .card-action {
    display: flex;
  }

  .read-link {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent-terracotta);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap 0.15s ease, color 0.15s ease;
  }

  .read-link:hover {
    color: var(--accent-terracotta-hover);
    gap: 0.6rem;
  }

  .arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }

  @media (max-width: 640px) {
    .featured-card {
      padding: 1.75rem 1.5rem;
    }
    .card-title {
      font-size: 1.5rem;
    }
  }
</style>
